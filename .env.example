# Phase 0 reference only. No application currently reads these variables.
# Future development/test should use fake providers and publishing disabled.
APP_ENV=development
# Fill these in the untracked .env before running the backend or Compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nichepilot
DATABASE_URL=
TEST_DATABASE_URL=
ADMIN_API_TOKEN=
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_ROOT=./storage
AI_PROVIDER=fake
TREND_PROVIDER=fake
PUBLISHING_PROVIDER=fake
PUBLISHING_ENABLED=false
DRY_RUN=true
REQUIRE_MANUAL_APPROVAL=true
GLOBAL_AUTOMATION_ENABLED=false
# Add real provider credentials only when that adapter is implemented.
# Never place credential values in this file or commit a populated .env.
